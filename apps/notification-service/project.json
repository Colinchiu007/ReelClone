{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "notification-service",
  "projectType": "application",
  "sourceRoot": "apps/notification-service/src",
  "prefix": "reelclone",
  "tags": ["scope:notification", "type:app"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/notification-service/src --ext .ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/notification-service/tsconfig.spec.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/notification-service/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/notification-service/jest.config.js --passWithNoTests",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/notification-service"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch apps/notification-service/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/notification-service/Dockerfile -t reelclone/notification-service:latest .",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
