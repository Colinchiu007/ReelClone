# ============================================================
# notification-service 环境变量示例
# 复制此文件为 .env 并填写真实值，切勿提交 .env 到仓库
# ============================================================

# 运行环境：development | production | test
NODE_ENV=development

# -------------------- 服务端口 --------------------
# 与 docker-compose / nginx 上游约定的端口
PORT=3008

# -------------------- 数据库（PostgreSQL） --------------------
# 复用根目录 .env 中的数据库配置（main 库持有 notifications 表）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev
DATABASE_NAME=reelclone_main
DATABASE_SCHEMA=public

# -------------------- Redis 缓存 / Pub/Sub --------------------
# 复用根目录 .env 中的 Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=reelclone:

# -------------------- JWT 鉴权 --------------------
# 必须与 user-service / workbench-service 签发端使用同一密钥
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 微信小程序订阅消息 --------------------
# WECHAT_SUBSCRIBE_MOCK_MODE=true 时强制走 Mock；为 false 且 WECHAT_APPID 非空时走真实 API
WECHAT_SUBSCRIBE_MOCK_MODE=true
WECHAT_APPID=
WECHAT_SECRET=

# -------------------- 日志 --------------------
LOG_LEVEL=info
