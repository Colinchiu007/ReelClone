{
  "name": "@reelclone/notification-service",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone 通知服务：WebSocket 实时任务进度推送、站内通知列表、微信订阅消息推送",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "build": "tsc -p tsconfig.build.json",
    "serve": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "typeorm": "^0.3.20",
    "uuid": "^8.3.2"
  },
  "peerDependencies": {
    "@reelclone/common": "*",
    "@reelclone/database": "*",
    "@reelclone/observability": "*",
    "@reelclone/platform-data": "*",
    "@reelclone/swagger": "*"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^8.3.4",
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.5",
    "ts-jest": "^29.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
