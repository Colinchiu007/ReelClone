# ============================================================
# ReelClone miniprogram 环境变量示例
# 复制此文件为 .env 并填写真实值
# Taro 构建时通过 defineConstants 注入到小程序运行时
# ============================================================

# 运行环境
NODE_ENV=development

# -------------------- API 网关 --------------------
# 后端 API 基础地址（开发环境指向本地网关或 mock 服务）
API_BASE_URL=http://localhost:3000/api
WS_BASE_URL=ws://localhost:3008

# -------------------- 微信小程序 --------------------
# 微信小程序 AppID（需在微信公众平台注册后获取）
WECHAT_APPID=wx0000000000000000

# -------------------- 对象存储（OSS） --------------------
# 用于素材上传 STS 直传，需与 asset-service 配置一致
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=

# -------------------- 业务配置 --------------------
# 是否开启调试模式（输出详细日志）
DEBUG=true

# 默认分页大小
DEFAULT_PAGE_SIZE=20

# 视频生成最大时长（秒）
VIDEO_MAX_DURATION=10
