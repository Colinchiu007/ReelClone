{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@tarojs/taro", "webpack-env", "jest", "node"],
    "isolatedModules": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "__mocks__/**/*.ts",
    "jest.setup.ts"
  ]
}
