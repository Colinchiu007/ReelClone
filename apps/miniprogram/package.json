{
  "name": "@reelclone/miniprogram",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone 微信小程序：Taro 3.x + React 18 + TypeScript 复刻 WouwouAI 前端",
  "main": "./src/app.ts",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage"
  },
  "dependencies": {
    "@tarojs/components": "3.6.40",
    "@tarojs/helper": "3.6.40",
    "@tarojs/plugin-framework-react": "3.6.40",
    "@tarojs/plugin-platform-weapp": "3.6.40",
    "@tarojs/react": "3.6.40",
    "@tarojs/runtime": "3.6.40",
    "@tarojs/shared": "3.6.40",
    "@tarojs/taro": "3.6.40",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "peerDependencies": {
    "@reelclone/capability": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@tarojs/cli": "3.6.40",
    "@tarojs/test-utils-react": "0.1.1",
    "@tarojs/taro-loader": "3.6.40",
    "@tarojs/webpack5-runner": "3.6.40",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "3.6.40",
    "eslint": "^8.57.0",
    "eslint-config-taro": "3.6.40",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-refresh": "^0.14.0",
    "sass": "^1.77.6",
    "sass-loader": "^14.2.1",
    "stylelint": "^14.16.1",
    "ts-jest": "^29.1.4",
    "typescript": "^5.6.0",
    "webpack": "5.78.0"
  }
}
