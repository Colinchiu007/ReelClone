# ============================================================
# ReelClone user-service 环境变量示例
# 复制此文件为 .env 并填写真实值
# ============================================================

# 运行环境
NODE_ENV=development

# -------------------- 服务端口 --------------------
PORT=3002

# -------------------- 数据库（PostgreSQL） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev
DATABASE_NAME=reelclone_main
DATABASE_SCHEMA=public

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=reelclone:

# -------------------- JWT 鉴权 --------------------
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 短信服务（SMS） --------------------
# 服务商：aliyun | tencent | mock（本地无真实凭证时可置 mock 绕过）
SMS_PROVIDER=aliyun
# Mock 模式：true 时验证码固定 123456，不真实发送
SMS_MOCK_MODE=false
# 阿里云短信凭证
SMS_ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
SMS_ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
SMS_ALIYUN_SIGN_NAME=ReelClone
# 腾讯云短信凭证
SMS_TENCENT_SDK_APP_ID=1400000000
SMS_TENCENT_SECRET_ID=your_tencent_secret_id
SMS_TENCENT_SECRET_KEY=your_tencent_secret_key
SMS_TENCENT_SIGN_NAME=ReelClone
# 验证码模板（默认模板 code + 绑定手机专用模板；代码内过期 300s / 间隔 60s / 5 次尝试为常量）
SMS_TEMPLATE_CODE=SMS_DEFAULT
SMS_TEMPLATE_BIND_MOBILE=
