# ============================================================
# ReelClone user-service 环境变量示例
# 复制此文件为 .env 并填写真实值
# ============================================================

# 运行环境
NODE_ENV=development

# -------------------- 服务端口 --------------------
PORT=3002

# -------------------- 数据库（PostgreSQL） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev
DATABASE_NAME=reelclone_main
DATABASE_SCHEMA=public

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=reelclone:

# -------------------- JWT 鉴权 --------------------
JWT_SECRET=reelclone_dev_secret_at_least_32_chars_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 短信服务（SMS） --------------------
# Mock 模式：true 时验证码固定 123456，不真实发送
SMS_MOCK_MODE=true
# 短信服务商 AccessKey（为空时自动走 Mock 模式）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=ReelClone
# 验证码过期时间（秒）
SMS_CODE_EXPIRE_SECONDS=300
# 同一手机号发送间隔（秒，防重复发送）
SMS_SEND_LOCKOUT_SECONDS=60
