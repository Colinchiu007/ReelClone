# ============================================================
# template-service 环境变量示例
# 复制此文件为 .env 并填写真实值
# ============================================================

# 运行环境：development | production | test
NODE_ENV=development

# -------------------- 服务端口 --------------------
PORT=3005

# -------------------- 数据库（PostgreSQL） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev

# -------------------- JWT 鉴权 --------------------
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 日志 --------------------
LOG_LEVEL=info
