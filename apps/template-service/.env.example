# ============================================================
# template-service 环境变量示例
# 复制此文件为 .env 并填写真实值，切勿提交 .env
# 与服务代码 process.env.* / ConfigService 读取处保持一致，
# 完整权威参考见仓库根 .env.example
# ============================================================

# 运行环境：development | production | test
NODE_ENV=development
# 服务名（日志/指标标识）
SERVICE_NAME=template-service

# -------------------- 服务端口 --------------------
PORT=3005
# 是否启用 Swagger 文档（'true' / '1' 启用）
SWAGGER_ENABLED=true

# -------------------- 数据库（PostgreSQL：main + template 两连接） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev
DATABASE_SCHEMA=public
# 主库名（默认 reelclone_main，对账读取权威流水用）
DATABASE_NAME=reelclone
# 模板库名（默认 reelclone_template）
DATABASE_TEMPLATE_NAME=reelclone_template

# -------------------- Redis 缓存/队列 --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=reelclone:
REDIS_CONNECT_TIMEOUT=10000

# -------------------- JWT 鉴权（与网关/用户服务共享） --------------------
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- Temporal 工作流（用户上传视频转模板异步流程） --------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=reelclone
TEMPORAL_TLS_ENABLED=false
# Mock 模式：跳过 Temporal 调用，模拟进度更新（开发环境推荐 true，生产设为 false）
TEMPORAL_MOCK_MODE=true

# -------------------- 服务间通信 / 内部鉴权 --------------------
# 内部 API Key：调用 billing-service 时携带 x-api-key
INTERNAL_API_KEY=your_internal_api_key_please_rotate
# billing-service 地址（云托管环境用内网域名，勿用 localhost）
BILLING_SERVICE_URL=http://billing-service:3006

# billing 客户端重试/熔断参数（带默认值：重试 3 / 熔断阈值 5 / 冷却 30s）
BILLING_CLIENT_MAX_RETRIES=3
BILLING_CLIENT_CB_THRESHOLD=5
BILLING_CLIENT_CB_COOLDOWN_MS=30000

# -------------------- 业务参数（服务私有默认值） --------------------
# 模板被使用时奖励上传者的积分（未配置时默认 1）
TEMPLATE_REWARD_POINTS=5

# -------------------- 日志 --------------------
LOG_LEVEL=info