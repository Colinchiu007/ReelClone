# ============================================================
# ReelClone Media Worker 环境变量示例
# 复制为 .env 并按需填写
# 该服务为 Temporal Worker 长跑进程，不暴露业务 API，仅提供 /health 健康检查端点
# ============================================================

# 运行环境：development | production | test
NODE_ENV=development

# -------------------- 健康检查端口 --------------------
# Worker 不监听业务端口，仅监听 /health 端点供 K8s 探针使用
MEDIA_WORKER_PORT=3010

# -------------------- Temporal 工作流 --------------------
# Temporal Server 地址（host:port）
TEMPORAL_ADDRESS=localhost:7233
# Temporal 命名空间
TEMPORAL_NAMESPACE=reelclone
# Task Queue 由 @reelclone/temporal 的 TASK_QUEUE 常量统一定义，不支持环境变量覆盖
# Mock 模式：true 时 Activity 走 Mock 路径（libs/ai 与 libs/temporal 内置 Mock 实现）
# 开发环境默认开启，生产环境须设为 false
TEMPORAL_MOCK_MODE=true

# -------------------- 内部计费 API（真实模式必填） --------------------
# Temporal Worker 通过 billing-service 结算或释放已冻结积分。
BILLING_SERVICE_URL=http://billing-service:3006
# 必须与 billing-service 和 workbench-service 使用同一值；不要提交真实密钥。
INTERNAL_API_KEY=

# -------------------- 数据库（PostgreSQL） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_secret
DATABASE_NAME=reelclone_main
DATABASE_SCHEMA=public

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=reelclone:

# -------------------- 阿里云 OSS --------------------
# 留空则自动进入 Mock 模式
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# -------------------- Seedance 视频 AI --------------------
# 逗号分隔多 Key
SEEDANCE_API_KEYS=

# -------------------- LLM 大语言模型 --------------------
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# -------------------- 日志 --------------------
LOG_LEVEL=info
