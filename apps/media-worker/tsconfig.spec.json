{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
