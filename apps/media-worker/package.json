  "peerDependencies": {
    "@reelclone/common": "*",
    "@reelclone/database": "*",
    "@reelclone/ai": "*",
    "@reelclone/temporal": "*",
    "@reelclone/oss": "*"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
