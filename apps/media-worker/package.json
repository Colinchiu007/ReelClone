{
  "name": "@reelclone/media-worker",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone 媒体处理 Worker：Temporal Worker 节点，注册 FFmpeg / 内容审核 / Seedance / 视频分析 Activity",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "scripts": {
