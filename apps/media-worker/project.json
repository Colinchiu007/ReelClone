{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "media-worker",
  "projectType": "application",
  "sourceRoot": "apps/media-worker/src",
  "prefix": "reelclone",
  "tags": ["type:app", "scope:worker", "scope:media"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/media-worker/src --ext .ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/media-worker/tsconfig.spec.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/media-worker/jest.config.js --passWithNoTests",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/media-worker"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/media-worker/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx apps/media-worker/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
