{
  "name": "@reelclone/asset-service",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone 资产服务微服务：素材上传 STS Token 签发、资产 CRUD、真人形象组管理",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --config jest.config.js",
    "serve": "tsx src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "peerDependencies": {
    "@reelclone/common": "*",
    "@reelclone/database": "*",
    "@reelclone/oss": "*",
    "@reelclone/observability": "*",
    "@reelclone/platform-data": "*",
    "@reelclone/swagger": "*"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
