# ============================================================
# ReelClone asset-service 环境变量示例
# 复制此文件为 .env 并填写真实值
# ============================================================

# 运行环境
NODE_ENV=development

# -------------------- 服务端口 --------------------
PORT=3003

# -------------------- 数据库（PostgreSQL） --------------------
# asset-service 使用 main 库（持有 assets / avatar_groups 表）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev
DATABASE_NAME=reelclone_main
DATABASE_SCHEMA=public

# -------------------- JWT 鉴权 --------------------
# 需与 auth-service 签发端使用相同密钥，否则 token 校验失败
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 对象存储（阿里云 OSS） --------------------
# 任一凭证缺失或 OSS_MOCK=true 时自动进入 Mock 模式：
#   - STSService 返回模拟 STS Token
#   - OSSService 的上传/删除仅记录日志，不真正访问 OSS
OSS_MOCK=true
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 可选：自定义 Endpoint
OSS_ENDPOINT=
# STS 角色 ARN（小程序直传必填，为空时无法签发真实 STS Token）
OSS_ROLE_ARN=
OSS_ROLE_SESSION_NAME=reelclone-sts
# 上传单文件大小上限（字节），默认 100MB
OSS_MAX_CONTENT_LENGTH=104857600
