# ============================================================
# ReelClone billing-service 环境变量示例
# 复制为 .env 并按需修改，切勿提交 .env
# ============================================================

# -------------------- 运行环境 --------------------
NODE_ENV=development

# -------------------- 服务端口 --------------------
PORT=3006

# -------------------- 数据库（PostgreSQL，复用主库实例） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------- JWT（与网关/用户服务共享） --------------------
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 内部 API Key（其他微服务调用本服务时携带 x-api-key） --------------------
INTERNAL_API_KEY=your_internal_api_key_please_rotate

# -------------------- 缓存 TTL（秒） --------------------
POINTS_BALANCE_CACHE_TTL=60
POINTS_FROZEN_CACHE_TTL=60
POINTS_IDEMPOTENCY_TTL=86400
