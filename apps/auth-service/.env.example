# ============================================================
# ReelClone Auth Service 环境变量示例
# 复制为 .env 并按需填写
# ============================================================

# 运行环境：development | production | test
NODE_ENV=development

# -------------------- 服务端口 --------------------
PORT=3001

# -------------------- 数据库（PostgreSQL） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_secret
DATABASE_NAME=reelclone_main
DATABASE_SCHEMA=public

# -------------------- Redis 缓存/黑名单 --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=reelclone:

# -------------------- JWT 鉴权 --------------------
JWT_SECRET=reelclone_dev_secret_at_least_32_chars_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 微信小程序 --------------------
# 留空或设置 WECHAT_MOCK_MODE=true 走 Mock 模式（无需真实凭证）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK_MODE=true

# -------------------- 日志 --------------------
LOG_LEVEL=info
