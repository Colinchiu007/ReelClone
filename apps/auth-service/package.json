{
  "name": "@reelclone/auth-service",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone 认证服务：微信小程序登录、JWT Token 刷新、登出（黑名单）",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --config jest.config.js",
    "serve": "tsx src/main.ts",
    "start": "node dist/apps/auth-service/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.1"
  },
  "peerDependencies": {
    "@reelclone/adapters-wechat": "*",
    "@reelclone/common": "*",
    "@reelclone/database": "*",
    "@reelclone/observability": "*",
    "@reelclone/platform-data": "*",
    "@reelclone/swagger": "*"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^8.3.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
