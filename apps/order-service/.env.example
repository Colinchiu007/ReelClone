# ============================================================
# ReelClone order-service 环境变量示例
# 复制此文件为 .env 并填写真实值
# ============================================================

# -------------------- 运行环境 --------------------
NODE_ENV=development

# -------------------- 服务端口 --------------------
PORT=3009

# -------------------- 数据库（PostgreSQL） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------- JWT 鉴权（与网关/用户服务共享） --------------------
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 内部 API Key（调用 billing-service 时携带 x-api-key） --------------------
INTERNAL_API_KEY=your_internal_api_key_please_rotate

# -------------------- billing-service 地址 --------------------
BILLING_SERVICE_URL=http://billing-service:3006

# -------------------- 微信支付 --------------------
# Mock 模式开关：true 时不调用真实微信支付 API，便于开发联调
WECHAT_PAY_MOCK_MODE=true
# 商户号（为空时自动启用 Mock 模式）
WECHAT_PAY_MCHID=
# 商户 API V3 密钥
WECHAT_PAY_APIV3_KEY=
# 商户私钥（PEM）
WECHAT_PAY_PRIVATE_KEY=
# 商户证书序列号
WECHAT_PAY_CERT_SERIAL=
# 微信小程序 AppID
WECHAT_PAY_APPID=
# 支付通知地址
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/webhooks/wechat-pay

# -------------------- 订单配置 --------------------
# 订单过期时间（分钟）
ORDER_EXPIRE_MINUTES=30
