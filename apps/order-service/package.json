{
  "name": "@reelclone/order-service",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone 订单服务：套餐浏览、订单创建、微信支付调起、支付回调处理、订单查询",
  "main": "./src/main.ts",
  "scripts": {
    "start": "tsx watch src/main.ts",
