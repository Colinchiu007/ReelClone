# ============================================================
# ReelClone benchmark-service 环境变量示例
# 复制为 .env 并按需修改，切勿提交 .env
# ============================================================

# -------------------- 运行环境 --------------------
NODE_ENV=development

# -------------------- 服务端口 --------------------
PORT=3004

# -------------------- 数据库（PostgreSQL，复用主库实例） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------- JWT（与网关/用户服务共享） --------------------
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 内部 API Key（调用 billing-service 时携带 x-api-key） --------------------
INTERNAL_API_KEY=your_internal_api_key_please_rotate

# -------------------- billing-service 内部调用地址 --------------------
BILLING_SERVICE_URL=http://billing-service:3006

# -------------------- Temporal --------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=reelclone
TEMPORAL_TLS_ENABLED=false
# Mock 模式：true 时跳过真实 Temporal 调用，直接更新状态模拟进度
TEMPORAL_MOCK_MODE=true

# -------------------- 业务参数 --------------------
# 对标解析默认消耗积分
BENCHMARK_ESTIMATED_POINTS=300
