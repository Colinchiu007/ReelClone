{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "admin-service",
  "sourceRoot": "apps/admin-service/src",
  "projectType": "application",
  "prefix": "reelclone",
  "tags": ["scope:admin", "type:app"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/admin-service/src --ext .ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/admin-service/tsconfig.spec.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/admin-service/jest.config.js",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/admin-service"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/admin-service/tsconfig.build.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch apps/admin-service/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
