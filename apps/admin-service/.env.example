# ============================================================
# ReelClone admin-service 环境变量示例
# 复制为 .env 并按需修改，切勿提交 .env
# ============================================================

# -------------------- 运行环境 --------------------
NODE_ENV=development

# -------------------- 服务端口 --------------------
ADMIN_SERVICE_PORT=3011

# -------------------- 数据库（PostgreSQL，复用主库实例） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev

# -------------------- Redis --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------- JWT（与 auth-service 共享 JWT_SECRET） --------------------
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 内部 API Key（调用其他微服务时携带 x-api-key） --------------------
INTERNAL_API_KEY=your_internal_api_key_please_rotate

# -------------------- 下游微服务地址（admin-service 通过 HTTP 调用） --------------------
# billing-service（人工调账 / 积分流水）
BILLING_SERVICE_URL=http://billing-service:3006
# template-service（模板审核代理）
TEMPLATE_SERVICE_URL=http://template-service:3005
# order-service（订单退款）
ORDER_SERVICE_URL=http://order-service:3007
# notification-service（公告广播 / 定向推送）
NOTIFICATION_SERVICE_URL=http://notification-service:3008
# asset-service（形象组授权审核）
ASSET_SERVICE_URL=http://asset-service:3003

# -------------------- 日志 --------------------
LOG_LEVEL=info
