{
  "name": "@reelclone/temporal",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone Temporal 工作流库：工作流定义、Activity、Worker",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "worker:start": "ts-node -P tsconfig.json src/worker/temporal.worker.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.10.0",
    "@temporalio/client": "^1.10.0",
    "@temporalio/common": "^1.10.0",
    "@temporalio/worker": "^1.10.0",
    "@temporalio/workflow": "^1.10.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "axios": "^1.7.0",
    "ioredis": "^5.4.0",
    "uuid": "^8.3.2"
  },
  "peerDependencies": {
    "@reelclone/ai": "*",
    "@reelclone/oss": "*"
  },
  "peerDependenciesMeta": {
    "@reelclone/ai": {
      "optional": true
    },
    "@reelclone/oss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@types/uuid": "^8.3.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.4"
  }
}
