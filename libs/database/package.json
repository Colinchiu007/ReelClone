{
  "name": "@reelclone/database",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone 数据访问库：ORM、实体定义、迁移脚本、仓储层",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "migration:run": "tsx src/migration-runner.ts",
    "migration:generate": "echo \"TODO: 迁移生成（使用 typeorm migration:generate）\" && exit 0"
  },
  "dependencies": {
    "@nestjs/typeorm": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^8.3.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/uuid": "^8.3.4",
    "jest": "^29.7.0",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
