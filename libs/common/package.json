{
  "name": "@reelclone/common",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone 共享通用库：统一响应、错误码、异常过滤器、JWT 守卫、限流守卫、工具函数",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
