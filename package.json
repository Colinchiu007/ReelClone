{
  "name": "reelclone",
  "version": "0.0.0",
  "private": true,
  "description": "ReelClone - WouwouAI 微信小程序 1:1 复刻项目",
  "license": "UNLICENSED",
  "scripts": {
    "bootstrap": "nx run-many --target=install --all --parallel",
    "docker:bootstrap": "node tools/bootstrap.js",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "lint": "eslint \"apps/**/src/**/*.ts\" \"libs/**/src/**/*.ts\" --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test:unit": "jest --passWithNoTests",
    "test:unit:coverage": "jest --passWithNoTests --coverage",
    "test:miniprogram": "jest --config apps/miniprogram/jest.config.js",
    "test:miniprogram:coverage": "jest --config apps/miniprogram/jest.config.js --coverage",
    "test:integration": "jest --passWithNoTests --config jest.integration.config.js",
    "test:e2e": "cd tests/integration && jest --config jest.config.js",
    "test:e2e:flows": "cd tests/integration && jest --config jest.config.js --testPathPattern=flows",
    "test:e2e:api": "cd tests/integration && jest --config jest.config.js --testPathPattern=api",
    "build": "nx run-many -t build --all",
    "build:libs": "node scripts/build-libs.js",
    "build:services": "nx run-many -t build --all --projects='apps/*'",
    "build:miniprogram": "nx run capability:build && nx run miniprogram:build:weapp",
    "build:admin": "nx run admin-web:build",
    "migration:run": "ts-node --transpile-only -r tsconfig-paths/register libs/database/src/migration-runner.ts",
    "migration:generate": "echo 'Migration targets configured per-service'",
    "gen:types": "tsx scripts/gen-types-local.ts",
    "gen:types:single": "tsx scripts/gen-types-local.ts scripts/fixtures/auth-service.openapi.json",
    "gen:types:check": "tsx scripts/gen-types-local.ts && git diff --exit-code apps/miniprogram/src/types/generated/ apps/admin-web/src/types/generated/",
    "extract:openapi": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"commonjs\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" -r tsconfig-paths/register scripts/extract-openapi.ts",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/testing": "^11.1.18",
    "@tarojs/taro-loader": "3.6.40",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "nx": "^19.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/*"
  ],
  "dependencies": {
    "@nestjs/platform-express": "^11.1.18",
    "bcrypt": "^6.0.0",
    "tsconfig-paths": "^4.2.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "brace-expansion": "^1.1.12",
    "request": {
      "uuid": "3.4.0"
    },
    "webpack": "5.78.0",
    "swiper": "12.1.2"
  }
}
