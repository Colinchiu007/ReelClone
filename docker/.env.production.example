# ============================================================
# ReelClone 生产环境变量清单（示例）
# ============================================================
# 使用方式：
#   cd docker
#   cp .env.production.example .env.production
#   vim .env.production   # 填写真实凭证
#
# 安全提示：
#   1. 切勿提交 .env.production 到 Git 仓库
#   2. 所有密码/密钥必须使用强随机值（建议 openssl rand -hex 32）
#   3. 生产环境所有 Mock 模式必须设为 false
# ============================================================

# -------------------- 基础配置 --------------------
NODE_ENV=production
TZ=Asia/Shanghai
LOG_LEVEL=info

# -------------------- PostgreSQL 16 --------------------
# 业务主库（用户/资产/作品/订单/通知）
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_NAME=reelclone_main
DATABASE_SCHEMA=public
# 各业务数据库名（与 init-db.sql 保持一致）
DATABASE_NAME_BILLING=reelclone_billing
DATABASE_NAME_TEMPLATE=reelclone_template
DATABASE_NAME_BENCHMARK=reelclone_benchmark

# Temporal 使用独立用户（init-db.sql 自动创建）
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=CHANGE_ME_TEMPORAL_PASSWORD

# -------------------- Redis 7 --------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_PREFIX=reelclone:

# -------------------- JWT 鉴权 --------------------
# 至少 32 字符强随机值：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- 内部 API Key（服务间调用） --------------------
# billing-service 校验 x-api-key，调用方（workbench/benchmark/order）需携带
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY_ROTATE

# -------------------- 微信小程序登录 --------------------
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
# 生产环境必须为 false
WECHAT_MOCK_MODE=false

# -------------------- 微信支付 --------------------
# 商户号（为空时 order-service 自动走 Mock，生产环境必须填写）
WECHAT_PAY_MCHID=your_mch_id
# 商户证书序列号
WECHAT_PAY_SERIAL_NO=your_cert_serial_no
# 商户私钥（PEM 格式，多行用 \n 连接）
WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----
# API V3 密钥
WECHAT_PAY_API_V3_KEY=your_api_v3_key
# 支付通知地址（必须为 HTTPS 且公网可达）
WECHAT_PAY_NOTIFY_URL=https://api.your-domain.com/api/v1/webhooks/wechat-pay
# Mock 模式（生产必须 false）
WECHAT_PAY_MOCK_MODE=false
# 订单过期时间（分钟）
ORDER_EXPIRE_MINUTES=30

# -------------------- Seedance 视频 AI --------------------
# 逗号分隔多 Key 轮询，避免单 Key 限流
SEEDANCE_API_KEYS=key1,key2,key3

# -------------------- LLM 大语言模型 --------------------
LLM_API_KEY=your_llm_api_key
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# -------------------- Temporal 工作流引擎 --------------------
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=reelclone
# 生产环境必须为 false（true 时跳过真实 Temporal 调用）
TEMPORAL_MOCK_MODE=false
# Task Queue 名称（须与 Workflow / Worker 一致）
MEDIA_WORKER_TASK_QUEUE=reelclone-tasks
# Worker 健康检查端口（仅 /health，无业务 API）
MEDIA_WORKER_PORT=3010

# -------------------- 阿里云 OSS --------------------
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=reelclone-assets
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STS 角色 ARN（小程序直传必填）
OSS_ROLE_ARN=
OSS_ROLE_SESSION_NAME=reelclone-sts
# 上传单文件大小上限（字节，默认 100MB）
OSS_MAX_CONTENT_LENGTH=104857600
# 生产环境必须为 false（true 时 OSS 上传/删除仅记录日志）
OSS_MOCK=false

# -------------------- 短信服务（SMS） --------------------
SMS_ACCESS_KEY_ID=your_sms_access_key_id
SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret
SMS_SIGN_NAME=ReelClone
# Mock 模式（生产必须 false，否则验证码固定 123456）
SMS_MOCK_MODE=false
SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_LOCKOUT_SECONDS=60

# -------------------- 微信订阅消息（notification-service） --------------------
WECHAT_SUBSCRIBE_MOCK_MODE=false

# -------------------- billing-service 缓存 TTL（秒） --------------------
POINTS_BALANCE_CACHE_TTL=60
POINTS_FROZEN_CACHE_TTL=60
POINTS_IDEMPOTENCY_TTL=86400

# -------------------- benchmark-service 业务参数 --------------------
BENCHMARK_ESTIMATED_POINTS=300

# -------------------- workbench-service 任务队列 --------------------
TASK_QUEUE=reelclone-tasks

# -------------------- 各服务端口（与 docker-compose.prod.yml 一致） --------------------
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
ASSET_SERVICE_PORT=3003
BENCHMARK_SERVICE_PORT=3004
TEMPLATE_SERVICE_PORT=3005
BILLING_SERVICE_PORT=3006
WORKBENCH_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008
ORDER_SERVICE_PORT=3009

# -------------------- 服务间调用地址（容器名直连） --------------------
BILLING_SERVICE_URL=http://billing-service:3006

# -------------------- 域名与 SSL（Nginx 使用） --------------------
SERVER_NAME=api.your-domain.com
