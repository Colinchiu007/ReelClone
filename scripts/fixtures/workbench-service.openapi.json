{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/generations": {
      "post": {
        "operationId": "GenerationController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGenerationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "提交生成任务",
        "tags": ["generation"]
      },
      "get": {
        "operationId": "GenerationController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "页码，从 1 开始",
            "schema": {
              "minimum": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "每页条数（1-100）",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "任务状态筛选（PENDING/RUNNING/COMPLETED/FAILED）",
            "schema": {
              "example": "COMPLETED",
              "type": "string",
              "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED"]
            }
          },
          {
            "name": "generationType",
            "required": false,
            "in": "query",
            "description": "生成类型筛选（文生视频/图生视频/3D 建模等）",
            "schema": {
              "example": "TEXT_TO_VIDEO",
              "type": "string",
              "enum": [
                "TEXT_TO_VIDEO",
                "IMAGE_TO_VIDEO_FIRST",
                "IMAGE_TO_VIDEO_FIRST_LAST",
                "3D_MODELING",
                "EDIT_VIDEO",
                "EXTEND_VIDEO",
                "TEXT_GENERATE",
                "IMAGE_GENERATE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "任务列表（分页 + 筛选）",
        "tags": ["generation"]
      }
    },
    "/api/v1/generations/{id}": {
      "get": {
        "operationId": "GenerationController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "任务详情",
        "tags": ["generation"]
      }
    },
    "/api/v1/generations/{id}/cancel": {
      "post": {
        "operationId": "GenerationController_cancel",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "取消任务",
        "tags": ["generation"]
      }
    },
    "/api/v1/generations/{id}/retry": {
      "post": {
        "operationId": "GenerationController_retry",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "重试任务",
        "tags": ["generation"]
      }
    },
    "/api/v1/works": {
      "get": {
        "operationId": "WorkController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "页码，从 1 开始",
            "schema": {
              "minimum": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "每页条数（1-100）",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "作品状态筛选（PENDING/PROCESSING/COMPLETED/FAILED/CANCELLED/REJECTED/DELETED）",
            "schema": {
              "example": "COMPLETED",
              "type": "string",
              "enum": [
                "PENDING",
                "PROCESSING",
                "COMPLETED",
                "FAILED",
                "CANCELLED",
                "REJECTED",
                "DELETED"
              ]
            }
          },
          {
            "name": "workType",
            "required": false,
            "in": "query",
            "description": "作品类型筛选（TEXT/IMAGE/VIDEO）",
            "schema": {
              "example": "VIDEO",
              "type": "string",
              "enum": ["TEXT", "IMAGE", "VIDEO"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "作品列表（分页 + 筛选）",
        "tags": ["work"]
      }
    },
    "/api/v1/works/{id}": {
      "get": {
        "operationId": "WorkController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "作品详情（校验所有权）",
        "tags": ["work"]
      },
      "delete": {
        "operationId": "WorkController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "删除作品（软删除，保留 OSS 文件 30 天）",
        "tags": ["work"]
      }
    },
    "/api/v1/works/{id}/publish-template": {
      "post": {
        "operationId": "WorkController_publishTemplate",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishFromWorkDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "作品转模板（发布已完成作品为模板）",
        "tags": ["work"]
      }
    }
  },
  "info": {
    "title": "Workbench Service API",
    "description": "工作台服务：作品管理、生成任务、复刻发布",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "workbench",
      "description": "workbench 服务接口"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-Bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "description": "JWT Bearer 鉴权。在「Authorize」中粘贴 accessToken（不含 \"Bearer \" 前缀）。由 auth-service 通过 POST /api/v1/auth/wechat-login 签发。",
        "in": "header"
      }
    },
    "schemas": {
      "CreateGenerationDto": {
        "type": "object",
        "properties": {
          "generationType": {
            "type": "string",
            "description": "生成类型（文生视频/图生视频/3D 建模/编辑视频等）",
            "example": "TEXT_TO_VIDEO",
            "enum": [
              "TEXT_TO_VIDEO",
              "IMAGE_TO_VIDEO_FIRST",
              "IMAGE_TO_VIDEO_FIRST_LAST",
              "3D_MODELING",
              "EDIT_VIDEO",
              "EXTEND_VIDEO",
              "TEXT_GENERATE",
              "IMAGE_GENERATE"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "提示词（最多 2000 字符）",
            "example": "一只柴犬在草地上奔跑，电影感镜头",
            "maxLength": 2000
          },
          "model": {
            "type": "string",
            "description": "模型 ID（默认 seedance2-pro）",
            "example": "seedance2-pro"
          },
          "resolution": {
            "type": "string",
            "description": "分辨率（视频类：480p/720p/1080p）",
            "example": "720p",
            "enum": ["480p", "720p", "1080p"]
          },
          "aspectRatio": {
            "type": "string",
            "description": "宽高比（9:16 竖屏 / 16:9 横屏 / 1:1 正方形）",
            "example": "9:16",
            "enum": ["9:16", "16:9", "1:1"]
          },
          "duration": {
            "type": "number",
            "description": "时长（秒，视频类，可选 5 或 10）",
            "example": 5,
            "minimum": 1
          },
          "referenceImages": {
            "description": "参考图 asset key 数组",
            "example": ["assets/image/user-uuid/20260731-ref1.png"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "referenceVideo": {
            "type": "string",
            "description": "参考视频 asset key",
            "example": "assets/video/user-uuid/20260731-ref.mp4"
          },
          "referenceAudio": {
            "type": "string",
            "description": "参考音频 asset key",
            "example": "assets/audio/user-uuid/20260731-bg.mp3"
          },
          "firstFrame": {
            "type": "string",
            "description": "首帧图 asset key",
            "example": "assets/image/user-uuid/20260731-first.png"
          },
          "lastFrame": {
            "type": "string",
            "description": "尾帧图 asset key",
            "example": "assets/image/user-uuid/20260731-last.png"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "幂等键（重复请求返回已有 work，最多 128 字符）",
            "example": "a3f5b8c9-1d2e-3f4a-5b6c-7d8e9f0a1b2c",
            "maxLength": 128
          },
          "templateId": {
            "type": "string",
            "description": "来源模板 ID（基于模板创作时传入，用于模板使用次数 +1）",
            "example": "a1b2c3d4-uuid"
          },
          "benchmarkId": {
            "type": "string",
            "description": "对标解析 ID（从对标解析一键复刻时传入，用于溯源）",
            "example": "b2c3d4e5-uuid"
          }
        },
        "required": ["generationType", "prompt"]
      },
      "PublishFromWorkDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "模板标题（最多 128 字符）",
            "example": "夏日饮品推广短视频模板",
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "description": "详细描述（最多 2000 字符）",
            "example": "适用于饮品/快消品推广，含品牌 LOGO 占位与字幕样式",
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "description": "分类（最多 64 字符）",
            "example": "营销推广",
            "maxLength": 64
          },
          "industry": {
            "type": "string",
            "description": "适用行业（最多 64 字符）",
            "example": "餐饮/快消",
            "maxLength": 64
          },
          "platform": {
            "type": "string",
            "description": "适用平台（最多 32 字符，如 douyin/wechat/xhs）",
            "example": "douyin",
            "maxLength": 32
          },
          "tags": {
            "description": "标签数组",
            "example": ["夏日", "饮品", "推广"],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["title"]
      }
    }
  }
}
