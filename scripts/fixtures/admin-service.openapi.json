  "info": {
    "title": "Admin Service API",
    "description": "运营后台：用户/订单/套餐/审核/对账/统计/通知/内容/API Key 管理",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "admin",
      "description": "admin 服务接口"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-Bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "description": "JWT Bearer 鉴权。在「Authorize」中粘贴 accessToken（不含 \"Bearer \" 前缀）。由 auth-service 通过 POST /api/v1/auth/wechat-login 签发。",
        "in": "header"
      }
    },
    "schemas": {
      "UpdateUserStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "目标状态（ACTIVE 正常 / FROZEN 封禁）",
            "example": "FROZEN",
            "enum": ["ACTIVE", "FROZEN", "DELETED"]
          }
        },
        "required": ["status"]
      },
      "UpdateUserRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "目标角色（USER / ADMIN / SUPER_ADMIN）",
            "example": "ADMIN",
            "enum": ["USER", "ADMIN", "SUPER_ADMIN"]
          }
        },
        "required": ["role"]
      },
      "GrantPointsDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "调账数量（正整数，>0）",
            "example": 100
          },
          "reason": {
            "type": "string",
            "description": "调账原因（用于操作日志，最多 256 字符）",
            "example": "补偿用户积分"
          }
        },
        "required": ["amount", "reason"]
      },
      "ReviewTemplateDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "审核后状态（ACTIVE 审核通过并上线 / REJECTED 拒绝）",
            "example": "ACTIVE",
            "enum": ["ACTIVE", "REJECTED"]
          },
          "reviewNote": {
            "type": "string",
            "description": "审核备注（可选）",
            "example": "模板内容符合规范，审核通过"
          }
        },
        "required": ["status"]
      },
      "ReviewAvatarGroupDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "授权状态（APPROVED 授权通过 / EXPIRED 授权过期）",
            "example": "APPROVED",
            "enum": ["APPROVED", "EXPIRED"]
          },
          "note": {
            "type": "string",
            "description": "审核备注（可选）",
            "example": "形象组符合规范，授权通过"
