            "example": 1000
          },
          "bonusPoints": {
            "type": "number",
            "description": "赠送积分数量（可选）",
            "example": 200
          },
          "duration": {
            "type": "number",
            "description": "有效期（天，可选）",
            "example": 30
          },
          "features": {
            "description": "功能特性（JSON 字符串数组，可选）",
            "example": ["高清导出", "无水印"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "description": "套餐类型（SUBSCRIPTION 订阅 / ONE_TIME 一次性）",
            "example": "ONE_TIME",
            "enum": ["SUBSCRIPTION", "ONE_TIME"]
          },
          "sort": {
            "type": "number",
            "description": "排序值（可选，值越小越靠前）",
            "example": 1
          }
        },
        "required": ["name", "price", "type"]
      },
