# ============================================================
# ReelClone 环境变量示例（权威配置模板）
# 复制此文件为 .env 并填写真实值，切勿提交 .env 到仓库
# 本文件为所有微服务 + 小程序共享的权威配置参考，按分组维护，
# 值即各服务默认值。请与服务代码中 process.env.* / ConfigService 读取处保持一致。
# ============================================================

# 运行环境：development | production | test
NODE_ENV=development

# -------------------- 服务通用 --------------------
# 当前服务名（用于日志/指标标识，取值与启动的 app 目录名一致）
SERVICE_NAME=
# 服务监听端口（各服务默认值：auth=3001, user=3002, asset=3003, benchmark=3004, template=3005, billing=3006, workbench=3007, notification=3008, order=3009, admin=3011, media-worker=3010；admin 读 ADMIN_SERVICE_PORT、media-worker 读 MEDIA_WORKER_PORT，其余读 PORT）
PORT=3007
# admin-service / media-worker 读取各自专属端口变量（其余服务读 PORT）
ADMIN_SERVICE_PORT=3011
MEDIA_WORKER_PORT=3010
# 是否启用 Swagger 文档（'true' / '1' 启用）
SWAGGER_ENABLED=true

# -------------------- 数据库（PostgreSQL，主/计费/模板/竞品分析 4 连接） --------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=reelclone
DATABASE_PASSWORD=reelclone_dev
# 主库名（默认 reelclone_main）
DATABASE_NAME=reelclone
DATABASE_SCHEMA=public
# 计费库名（默认 reelclone_billing）
DATABASE_BILLING_NAME=reelclone_billing
# 模板库名（默认 reelclone_template）
DATABASE_TEMPLATE_NAME=reelclone_template
# 竞品分析库名（默认 reelclone_benchmark）
DATABASE_BENCHMARK_NAME=reelclone_benchmark

# -------------------- Redis 缓存/队列 --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=reelclone:
REDIS_CONNECT_TIMEOUT=10000

# -------------------- 对象存储（OSS） --------------------
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=reelclone-assets
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STS 角色 ARN（小程序直传需要；未配置且未开 Mock 时生产环境 fail closed）
OSS_ROLE_ARN=
OSS_ROLE_SESSION_NAME=reelclone-sts
# 单文件上传上限（字节），默认 100MB
OSS_MAX_CONTENT_LENGTH=104857600
# 显式 Mock 开关（'true' / '1' 启用；development/test 缺凭证默认回退 Mock）
OSS_MOCK=false

# -------------------- 微信小程序 --------------------
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
# 微信适配器 Mock 开关（本地未配置真实凭证时置 true）
WECHAT_MOCK_MODE=false
# 微信订阅消息 Mock 开关（notification-service；未配置 WECHAT_APPID 时自动 Mock）
WECHAT_SUBSCRIBE_MOCK_MODE=false

# -------------------- 微信支付 --------------------
WECHAT_PAY_MCHID=your_mch_id
# 微信小程序 AppID（order-service 校验回调 body 用）
WECHAT_PAY_APPID=your_wechat_appid
WECHAT_PAY_SERIAL_NO=your_cert_serial_no
WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----
WECHAT_PAY_API_V3_KEY=your_api_v3_key
WECHAT_PAY_NOTIFY_URL=https://api.example.com/webhook/wechat-pay

# -------------------- Seedance 视频 AI（逗号分隔多 Key 轮询） --------------------
SEEDANCE_API_KEYS=key1,key2,key3

# -------------------- 视频下载器 --------------------
# 下载模式：mock | auto（默认 auto，未安装 lux/yt-dlp 时自动降级 mock）
VIDEO_DOWNLOADER=auto
# 下载文件输出目录
DOWNLOAD_OUTPUT_DIR=./downloads
# cookies.txt 文件路径（抖音等平台需要浏览器 cookies，用 "Get cookies.txt" 扩展导出）
# 留空则不传 cookies，抖音链接会因需要登录而下载失败
VIDEO_DOWNLOADER_COOKIES=

# -------------------- 大语言模型（LLM） --------------------
LLM_API_KEY=your_llm_api_key
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# -------------------- JWT 鉴权 --------------------
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=reelclone
JWT_AUDIENCE=reelclone-client

# -------------------- Temporal 工作流引擎 --------------------
# 云托管部署：填 Temporal CVM 内网 IP:7233（须在云托管服务设置-私有网络设置挂载同一上海 VPC）
# 本地开发：localhost:7233（docker compose 起 temporal 服务组即可）；CI：temporal:7233
# 详见 01-docs/20-Temporal部署方案.md
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=reelclone
# 是否启用 Mock 模式（development 默认开启，生产环境必须设为 false，否则工作流不真正执行）
TEMPORAL_MOCK_MODE=true
# 是否启用 TLS（VPC 内网 + 安全组隔离可为 false；公网直连 Temporal Server 时必须 true）
TEMPORAL_TLS_ENABLED=false

# -------------------- 短信服务（SMS） --------------------
# 服务商：aliyun | tencent | mock（本地无真实凭证时可置 mock 绕过）
SMS_PROVIDER=aliyun
# SMS Mock 开关（true 时跳过真实发送）
SMS_MOCK_MODE=false
# 阿里云短信
SMS_ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
SMS_ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
SMS_ALIYUN_SIGN_NAME=ReelClone
# 腾讯云短信
SMS_TENCENT_SDK_APP_ID=1400000000
SMS_TENCENT_SECRET_ID=your_tencent_secret_id
SMS_TENCENT_SECRET_KEY=your_tencent_secret_key
SMS_TENCENT_SIGN_NAME=ReelClone
# 验证码模板（默认模板 code + 绑定手机专用模板）
SMS_TEMPLATE_CODE=SMS_DEFAULT
SMS_TEMPLATE_BIND_MOBILE=
# 验证码过期时间（秒），默认 300（5 分钟），非法/未配置时回退默认值
SMS_CODE_EXPIRE_SECONDS=300
# 同一手机号发送间隔锁定时间（秒），默认 60（1 分钟），非法/未配置时回退默认值
SMS_SEND_LOCKOUT_SECONDS=60

# -------------------- Formance 账本系统 --------------------
FORMANCE_LEDGER_URI=http://localhost:3068
FORMANCE_LEDGER_SECRET=your_formance_secret

# -------------------- 新用户注册赠送积分 --------------------
# 新用户注册时赠送的初始积分（0=不赠送，E2E 测试建议设为 100）
NEW_USER_BONUS_POINTS=0

# -------------------- 业务参数（服务私有默认值） --------------------
# 竞品分析预估消耗积分（benchmark-service）
BENCHMARK_ESTIMATED_POINTS=50
# 模板回购奖励积分（template-service；未配置时默认 1）
TEMPLATE_REWARD_POINTS=5

# -------------------- OpenFGA 关系型授权 --------------------
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=your_openfga_store_id

# -------------------- 服务间通信 / 内部鉴权 --------------------
# 内部 API Key：微服务间调用时携带 x-api-key（调用 billing-service 等）
INTERNAL_API_KEY=your_internal_api_key_please_rotate
# 各服务内网地址（微服务间 HTTP 调用；云托管环境用内网域名，勿用 localhost）
BILLING_SERVICE_URL=http://billing-service:3006
TEMPLATE_SERVICE_URL=http://template-service:3005
USER_SERVICE_URL=http://user-service:3002
ASSET_SERVICE_URL=http://asset-service:3003
AUTH_SERVICE_URL=http://auth-service:3001
BENCHMARK_SERVICE_URL=http://benchmark-service:3004
WORKBENCH_SERVICE_URL=http://workbench-service:3007
ORDER_SERVICE_URL=http://order-service:3009
NOTIFICATION_SERVICE_URL=http://notification-service:3008

# -------------------- 计费 Mock 开关（服务私有） --------------------
# 是否跳过 billing 真实积分冻结（仅本地未启动 billing-service 时置 true；
# E2E 环境不设置此变量，积分冻结走真实链路以验证计费主路径）
BILLING_MOCK_MODE=false

# -------------------- 敏感配置加解密封钥 --------------------
# 用于 scripts/encrypt-system-config.ts 与 secret-encryption（AES-256-GCM 主密钥，32 字节）
SECRET_ENCRYPTION_KEY=

# -------------------- 集成测试专用（不参与生产） --------------------
# E2E 跳过数据库清理 / 健康检查 / teardown（本地调试加速用）
E2E_SKIP_DB_CLEANUP=false
E2E_SKIP_HEALTH_CHECK=false
E2E_SKIP_TEARDOWN=false
# 微信支付 Mock 开关（tests/integration setup 读取；本地未配真实支付凭证时置 true）
WECHAT_PAY_MOCK_MODE=false

# -------------------- 适配器运行画像（内部） --------------------
# sms / wechat 适配器 profile 运行时标识（测试与运行时探测用）
RUNTIME_PROFILE=default

# -------------------- 加密配置脚本专用（scripts/encrypt-system-config.ts） --------------------
# 完整连接串（未拆分为主机/端口/库名时直接用；脚本按需读取）
DATABASE_URL=postgresql://reelclone:reelclone_dev@localhost:5432/reelclone_main
# 主库完整连接串（脚本写密文配置用）
DATABASE_MAIN_URL=postgresql://reelclone:reelclone_dev@localhost:5432/reelclone_main

# -------------------- 日志与可观测性（可选） --------------------
LOG_LEVEL=info